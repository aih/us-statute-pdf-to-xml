   "lines": [
    {
     "role": "running-head",
     "text": "115 STAT. 902          PUBLIC LAW 107–94—DEC. 21, 2001"
    },
    {
     "role": "body",
     "text": "(c) ADDITIONAL DIC FOR CHILDREN.—Section 1311(b) is"
    },
    {
     "role": "body",
     "text": "amended by striking \"$222\" and inserting \"$234\"."
    },
    {
     "role": "body",
     "text": "(d) AID AND ATTENDANCE ALLOWANCE.—Section 1311(c) is"
    },
    {
     "role": "body",
     "text": "amended by striking \"$222\" and inserting \"$234\"."
    },
    {
     "role": "body",
     "text": "(e) HOUSEBOUND RATE.—Section 1311(d) is amended by striking"
    },
    {
     "role": "body",
     "text": "\"$107\" and inserting \"$112\"."
    },
    {
     "role": "body",
     "text": "SEC. 6. DEPENDENCY AND INDEMNITY COMPENSATION FOR CHIL-"
    },
    {
     "role": "body",
     "text": "DREN."
    },
    {
     "role": "body",
     "text": "(a) DIC FOR ORPHAN CHILDREN.—Section 1313(a) is amended—"
    },
    {
     "role": "body",
     "text": "(1) by striking \"$373\" in paragraph (1) and inserting \"$397\";"
    },
    {
     "role": "body",
     "text": "(2) by striking \"$538\" in paragraph (2) and inserting \"$571\";"
    },
    {
     "role": "body",
     "text": "(3) by striking \"$699\" in paragraph (3) and inserting \"$742\";"
    },
    {
     "role": "body",
     "text": "and"
    },
    {
     "role": "body",
     "text": "(4) by striking \"$699\" and \"$136\" in paragraph (4) and"
    },
    {
     "role": "body",
     "text": "inserting \"$742\" and \"$143\", respectively."
    },
    {
     "role": "body",
     "text": "(b) SUPPLEMENTAL DIC FOR DISABLED ADULT CHILDREN.—Sec-"
    },
    {
     "role": "body",
     "text": "tion 1314 is amended—"
    },
    {
     "role": "body",
     "text": "(1) by striking \"$222\" in subsection (a) and inserting \"$234\";"
    },
    {
     "role": "body",
     "text": "(2) by striking \"$373\" in subsection (b) and inserting \"$397\";"
    },
    {
     "role": "body",
     "text": "and"
    },
    {
     "role": "body",
     "text": "(3) by striking \"$188\" in subsection (c) and inserting \"$199\"."
    },
    {
     "role": "sidenote",
     "text": "38 USC 1114"
    },
    {
     "role": "sidenote",
     "text": "note."
    },
    {
     "role": "body",
     "text": "SEC. 7. EFFECTIVE DATE."
    },
    {
     "role": "body",
     "text": "The amendments made by this Act shall take effect on"
    },
    {
     "role": "body",
     "text": "December 1, 2001."
    },
    {
     "role": "body",
     "text": "Approved December 21, 2001."
    },
    {
     "role": "footnote",
     "text": "LEGISLATIVE HISTORY—H.R. 2540:"
    },
    {
     "role": "footnote",
     "text": "HOUSE REPORTS: No. 107–156 (Comm. on Veterans' Affairs)."
    },
    {
     "role": "footnote",
     "text": "CONGRESSIONAL RECORD, Vol. 147 (2001):"
    },
    {
     "role": "footnote",
     "text": "July 31, considered and passed House."
    },
    {
     "role": "footnote",
     "text": "Nov. 15, considered and passed Senate, amended."
    },
    {
     "role": "footnote",
     "text": "Dec. 11, House concurred in Senate amendments."
    }
   ],
