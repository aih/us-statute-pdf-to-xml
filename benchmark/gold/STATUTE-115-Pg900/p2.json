     "text": "E–5 ................................      935     O–4 ................................   1,155"
    },
    {
     "role": "body",
     "text": "E–6 ................................      935     O–5 ................................   1,272"
    },
    {
     "role": "body",
     "text": "E–7 ................................      967     O–6 ................................   1,433"
    },
    {
     "role": "body",
     "text": "E–8 ................................   1,021     O–7 ................................   1,549"
    },
