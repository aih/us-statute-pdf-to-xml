     "role": "running-head",
     "text": "97 STAT. 58"
    },
    {
     "role": "running-head",
     "text": "PUBLIC LAW 98-16—APR. 4, 1983"
    },
    {
     "role": "body",
     "text": "the President is authorized and requested to issue a proclamation"
    },
    {
     "role": "body",
     "text": "calling on all Government agencies and upon all the people of the"
    },
    {
     "role": "body",
     "text": "United States to observe such month with appropriate programs,"
    },
    {
     "role": "body",
     "text": "ceremonies, and activities, so as to testify to the great and signifi-"
    },
    {
     "role": "body",
     "text": "cant value of amateur baseball to the American way of life."
    },
    {
     "role": "body",
     "text": "Approved April 4, 1983."
    },
    {
     "role": "footnote",
     "text": "LEGISLATIVE HISTORY—H.J. Res. 175:"
    },
    {
     "role": "footnote",
     "text": "CONGRESSIONAL RECORD, Vol. 129 (1983):"
    },
    {
     "role": "footnote",
     "text": "Mar. 21, considered and passed House."
    },
    {
     "role": "footnote",
     "text": "Mar. 24, considered and passed Senate."
    }
   ],
