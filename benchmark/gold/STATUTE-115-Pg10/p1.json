   "lines": [
    {
     "role": "running-head",
     "text": "115 STAT. 10                PUBLIC LAW 107–8—MAY 11, 2001"
    },
    {
     "role": "body",
     "text": "Public Law 107–8"
    },
    {
     "role": "body",
     "text": "107th Congress"
    },
    {
     "role": "body",
     "text": "An Act"
    },
    {
     "role": "sidenote",
     "text": "May 11, 2001"
    },
    {
     "role": "sidenote",
     "text": "[H.R. 256]"
    },
    {
     "role": "body",
     "text": "To extend for 11 additional months the period for which chapter 12 of title 11"
    },
    {
     "role": "body",
     "text": "of the United States Code is reenacted."
    },
    {
     "role": "body",
     "text": "Be it enacted by the Senate and House of Representatives of"
    },
    {
     "role": "body",
     "text": "the United States of America in Congress assembled,"
    },
    {
     "role": "body",
     "text": "SECTION 1. AMENDMENTS."
    },
    {
     "role": "body",
     "text": "Section 149 of title I of division C of Public Law 105–277,"
    },
    {
     "role": "sidenote",
     "text": "11 USC"
    },
    {
     "role": "sidenote",
     "text": "1201–1208,"
    },
    {
     "role": "sidenote",
     "text": "1221–1231,"
    },
    {
     "role": "sidenote",
     "text": "and 1201 note."
    },
    {
     "role": "body",
     "text": "as amended by Public Law 106–5 and Public Law 106–70, is"
    },
    {
     "role": "body",
     "text": "amended—"
    },
    {
     "role": "body",
     "text": "(1) by striking “July 1, 2000” each place it appears and"
    },
    {
     "role": "body",
     "text": "inserting “June 1, 2001”; and"
    },
    {
     "role": "body",
     "text": "(2) in subsection (a)—"
    },
    {
     "role": "body",
     "text": "(A) by striking “September 30, 1999” and inserting"
    },
    {
     "role": "body",
     "text": "“June 30, 2000”; and"
    },
    {
     "role": "body",
     "text": "(B) by striking “October 1, 1999” and inserting “July"
    },
    {
     "role": "body",
     "text": "1, 2000”."
    },
    {
     "role": "sidenote",
     "text": "11 USC 1201"
    },
    {
     "role": "sidenote",
     "text": "note."
    },
    {
     "role": "body",
     "text": "SEC. 2. EFFECTIVE DATE."
    },
    {
     "role": "body",
     "text": "The amendments made by section 1 shall take effect on July"
    },
    {
     "role": "body",
     "text": "1, 2000."
    },
    {
     "role": "body",
     "text": "Approved May 11, 2001."
    },
    {
     "role": "footnote",
     "text": "LEGISLATIVE HISTORY—H.R. 256:"
    },
    {
     "role": "footnote",
     "text": "HOUSE REPORTS: No. 107–2 (Comm. on the Judiciary)."
    },
    {
     "role": "footnote",
     "text": "CONGRESSIONAL RECORD, Vol. 147 (2001):"
    },
    {
     "role": "footnote",
     "text": "Feb. 28, considered and passed House."
    },
    {
     "role": "footnote",
     "text": "Apr. 26, considered and passed Senate."
    }
   ],
