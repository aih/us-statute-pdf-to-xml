 "transcriptions": {
  "A": {
   "lines": [
    {
     "role": "running-head",
     "text": "97 STAT. 290"
    },
    {
     "role": "running-head",
     "text": "PUBLIC LAW 98-55—JULY 19, 1983"
    },
    {
     "role": "body",
     "text": "Public Law 98-55"
    },
    {
     "role": "body",
     "text": "98th Congress"
    },
    {
     "role": "body",
     "text": "Joint Resolution"
    },
    {
     "role": "sidenote",
     "text": "July 19, 1983"
    },
    {
     "role": "sidenote",
     "text": "[S.J. Res. 18]"
    },
    {
     "role": "body",
     "text": "Designating September 22, 1983, as \"American Business Women's Day\"."
    },
    {
     "role": "body",
     "text": "Whereas there are forty-three million working women integrally"
    },
    {
     "role": "body",
     "text": "involved in determining the direction of both the private and"
    },
    {
     "role": "body",
     "text": "public sectors of our Nation;"
    },
    {
     "role": "body",
     "text": "Whereas American businesswomen hold active, responsible, deci-"
    },
    {
     "role": "body",
     "text": "sionmaking roles at all levels of business, and thus influence the"
    },
    {
     "role": "body",
     "text": "direction of our Nation; and"
    },
    {
     "role": "body",
     "text": "Whereas the Congress recognizes the important contributions of"
    },
    {
     "role": "body",
     "text": "American businesswomen to our Nation's continuing vitality:"
    },
    {
     "role": "body",
     "text": "Now, therefore, be it"
    },
    {
     "role": "body",
     "text": "Resolved by the Senate and House of Representatives of the United"
    },
    {
     "role": "sidenote",
     "text": "American"
    },
    {
     "role": "sidenote",
     "text": "Business"
    },
    {
     "role": "sidenote",
     "text": "Women's Day."
    },
    {
     "role": "body",
     "text": "States of America in Congress assembled, That September 22, 1983, is"
    },
    {
     "role": "body",
     "text": "designated \"American Business Women's Day\". The President is"
    },
    {
     "role": "body",
     "text": "authorized and requested to issue a proclamation calling upon the"
    },
    {
     "role": "body",
     "text": "people of the United States to observe that day with appropriate"
    },
    {
     "role": "body",
     "text": "ceremonies and activities."
    },
    {
     "role": "body",
     "text": "Approved July 19, 1983."
    },
    {
     "role": "footnote",
     "text": "LEGISLATIVE HISTORY—S.J. Res. 18:"
    },
    {
     "role": "footnote",
     "text": "CONGRESSIONAL RECORD, Vol. 129 (1983):"
    },
    {
     "role": "footnote",
     "text": "Mar. 2, considered and passed Senate."
    },
    {
     "role": "footnote",
     "text": "June 30, considered and passed House."
    }
   ],
