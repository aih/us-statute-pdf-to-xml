    {
     "role": "running-head",
     "text": "PUBLIC LAW 98–30—MAY 18, 1983          97 STAT. 191"
    },
    {
     "role": "body",
     "text": "SEC. 4. The President of the United States is authorized and"
    },
    {
     "role": "body",
     "text": "requested to direct the American delegation to the United Nations"
    },
    {
     "role": "body",
     "text": "to introduce a resolution in the General Assembly calling upon that"
    },
    {
     "role": "body",
     "text": "body to designate May 21, 1983, as \"International Andrei Sakharov"
    },
    {
     "role": "body",
     "text": "Day\", to be observed by the United Nations with appropriate cere-"
    },
    {
     "role": "body",
     "text": "monies and activities."
    },
    {
     "role": "body",
     "text": "Approved May 18, 1983."
    },
    {
     "role": "footnote",
     "text": "LEGISLATIVE HISTORY—S.J. Res. 51:"
    },
    {
     "role": "footnote",
     "text": "CONGRESSIONAL RECORD, Vol. 129 (1983):"
    },
    {
     "role": "footnote",
     "text": "Apr. 13, considered and passed Senate."
    },
    {
     "role": "footnote",
     "text": "May 17, considered and passed House."
    },
    {
     "role": "footnote",
     "text": "WEEKLY COMPILATION OF PRESIDENTIAL DOCUMENTS, Vol. 19, No. 20 (1983):"
    },
    {
     "role": "footnote",
     "text": "May 18, Presidential statement."
    }
   ],
