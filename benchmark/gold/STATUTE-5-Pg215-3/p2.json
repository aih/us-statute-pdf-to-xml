   "role": "body",
   "text": "The two sums last mentioned to be applied to the payment of the"
  },
  {
   "role": "body",
   "text": "ordinary expenditures of the Senate and House of Representatives,"
  },
  {
   "role": "body",
   "text": "severally, and to no other purpose."
