   "lines": [
    {
     "role": "running-head",
     "text": "115 STAT. 2382          PUBLIC LAW 107–119—JAN. 15, 2002"
    },
    {
     "role": "body",
     "text": "Public Law 107–119"
    },
    {
     "role": "body",
     "text": "107th Congress"
    },
    {
     "role": "body",
     "text": "An Act"
    },
    {
     "role": "sidenote",
     "text": "Jan. 15, 2002"
    },
    {
     "role": "sidenote",
     "text": "[S. 1202]"
    },
    {
     "role": "body",
     "text": "To amend the Ethics in Government Act of 1978 (5 U.S.C. App.) to extend the"
    },
    {
     "role": "body",
     "text": "authorization of appropriations for the Office of Government Ethics through fiscal"
    },
    {
     "role": "body",
     "text": "year 2006."
    },
    {
     "role": "body",
     "text": "Be it enacted by the Senate and House of Representatives of"
    },
    {
     "role": "sidenote",
     "text": "Office of"
    },
    {
     "role": "sidenote",
     "text": "Government"
    },
    {
     "role": "sidenote",
     "text": "Ethics"
    },
    {
     "role": "body",
     "text": "the United States of America in Congress assembled,"
    },
    {
     "role": "body",
     "text": "SECTION 1. SHORT TITLE."
    },
    {
     "role": "sidenote",
     "text": "Authorization"
    },
    {
     "role": "sidenote",
     "text": "Act of 2001."
    },
    {
     "role": "sidenote",
     "text": "5 USC app."
    },
    {
     "role": "body",
     "text": "This Act may be cited as the \"Office of Government Ethics"
    },
    {
     "role": "body",
     "text": "Authorization Act of 2001\"."
    },
    {
     "role": "body",
     "text": "SEC. 2. EXTENSION OF AUTHORIZATION OF APPROPRIATIONS."
    },
    {
     "role": "body",
     "text": "Section 405 of the Ethics in Government Act of 1978 (5 U.S.C."
    },
    {
     "role": "body",
     "text": "App.) is amended by striking \"1997 through 1999\" and inserting"
    },
    {
     "role": "body",
     "text": "\"2002 through 2006\"."
    },
    {
     "role": "body",
     "text": "Approved January 15, 2002."
    },
    {
     "role": "footnote",
     "text": "LEGISLATIVE HISTORY—S. 1202:"
    },
    {
     "role": "footnote",
     "text": "SENATE REPORTS: No. 107–88 (Comm. on Governmental Affairs)."
    },
    {
     "role": "footnote",
     "text": "CONGRESSIONAL RECORD, Vol. 147 (2001):"
    },
    {
     "role": "footnote",
     "text": "Nov. 15, considered and passed Senate."
    },
    {
     "role": "footnote",
     "text": "Dec. 19, 20, considered and passed House."
    }
   ],
