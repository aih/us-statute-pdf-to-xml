# Copy to .env. docker-compose.yml loads this file with env_file; nothing here is read from compose itself.

# Anthropic API key for the benchmark judge (benchmark/judge.py).
ANTHROPIC_API_KEY=

# GovInfo API key. Request one at https://api.govinfo.gov/docs/ (api.data.gov signup).
GOVINFO_API_KEY=

# HuggingFace token with write access to HF_REPO_ID (fine-grained token, repo.write scope).
HF_TOKEN=

# Dataset repository that receives the Statutes at Large volumes.
HF_REPO_ID=dreamproit/us-statutes-at-large

# Optional overrides.
# JUDGE_MODEL=claude-opus-5
# Required when the Anthropic key is not scoped to a workspace (the API returns 400 asking for it).
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# DOCLING_ARTIFACTS_PATH=/root/.cache/docling/models
